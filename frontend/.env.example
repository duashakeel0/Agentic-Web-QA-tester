# Copy to .env and fill in for local dev if you need to point at a non-default
# backend - most local setups can leave this unset entirely (falls back to
# http://localhost:8000 in src/config.ts).

# Real deployed backend URL (e.g. your Railway URL) - set this as a build-time
# environment variable in Vercel/Netlify's own dashboard, not in a committed
# .env file, since it changes per-deployment.
VITE_API_BASE_URL=
