# Copy to .env and fill in real values. Never commit the real .env file.

# Dashboard login - single QA tester, so this is one username/password pair
# rather than a user table. Defaults to admin/admin if unset - change these.
AUTH_USERNAME=
AUTH_PASSWORD=

# Trello API credentials - get from https://trello.com/power-ups/admin
TRELLO_API_KEY=
TRELLO_TOKEN=

# Anthropic API key - get from https://console.anthropic.com/settings/keys
# Used by the Planner (and later Verifier/Reporter) agents.
ANTHROPIC_API_KEY=

# Ollama - local model used by the Explorer for per-action decisions.
# Defaults below assume `ollama serve` running locally with llama3.2 pulled
# (`ollama pull llama3.2`). llama3.2 is the 3B model - noticeably faster
# than llama3.1's 8B on CPU-only inference (check with `ollama ps`: if
# PROCESSOR shows 100% CPU with no GPU, you're compute-bound and model size
# matters a lot). Set back to llama3.1 if you want the larger model's
# somewhat more reliable selector picking and have the hardware for it.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# How long Ollama keeps the model loaded in memory after each call (its own
# default is 5m). Sent on every request so a normal gap between actions or
# between demo runs doesn't force a full model reload - set higher if your
# machine is slow to load the model, or lower to free memory sooner.
OLLAMA_KEEP_ALIVE=30m

# Set to "groq" to run the "ollama" provider slot on Groq's hosted Llama
# API instead of a local Ollama install - same free/local-model comparison
# arm, just genuinely fast hardware behind it, for when local CPU inference
# is too slow. Needs GROQ_API_KEY (free tier: https://console.groq.com/keys).
# Leave unset/"local" to keep using local Ollama (OLLAMA_HOST/MODEL above).
OLLAMA_BACKEND=local
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# SMTP - used by the Reporter to send an immediate email alert for any
# high-severity confirmed finding. An app password (not your real account
# password) works well here for Gmail/most providers.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
