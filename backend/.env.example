# Copy to .env and fill in real values. Never commit the real .env file.

# Trello API credentials - get from https://trello.com/power-ups/admin
TRELLO_API_KEY=
TRELLO_TOKEN=

# Anthropic API key - get from https://console.anthropic.com/settings/keys
# Used by the Planner (and later Verifier/Reporter) agents.
ANTHROPIC_API_KEY=
