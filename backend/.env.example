# Copy to .env and fill in real values. Never commit the real .env file.

# Trello API credentials - get from https://trello.com/power-ups/admin
TRELLO_API_KEY=
TRELLO_TOKEN=

# Anthropic API key - get from https://console.anthropic.com/settings/keys
# Used by the Planner (and later Verifier/Reporter) agents.
ANTHROPIC_API_KEY=

# Ollama - local model used by the Explorer for per-action decisions.
# Defaults below assume `ollama serve` running locally with llama3.1 pulled.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
